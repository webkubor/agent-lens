{
  "name": "agent-lens",
  "version": "0.3.0",
  "description": "A magpie gateway plugin that shows what each agent behind your gateway actually costs you: tokens, money, and the weight of the tool definitions it re-sends on every turn",
  "type": "module",
  "files": [
    "index.mjs",
    "agent-lens.hooks.mjs",
    "service.mjs",
    "lib",
    "page",
    "app",
    "brand/assets",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "agent",
    "usage",
    "cost",
    "comparison",
    "llm-gateway"
  ],
  "license": "MIT",
  "magpie": {
    "hooks": "./agent-lens.hooks.mjs",
    "page": {
      "title": "Agent Lens",
      "titles": {
        "zh": "Agent 透镜",
        "zh-TW": "Agent 透鏡",
        "ja": "Agent レンズ"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "service": {
        "port": 3492,
        "option": "port"
      }
    },
    "options": {
      "port": 3492,
      "dataDir": "",
      "usageLog": "",
      "agents": [],
      "gatewayTimeoutMs": 2000,
      "gatewayUrl": ""
    }
  },
  "main": "./index.mjs",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "node service.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webkubor/agent-lens.git"
  }
}
